<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Application Name permite identificar las sesiones de la app en SQL Server. -->
        <add name="AL_ESTILO_PIURA"
             connectionString="Server=LAPTOP-GH63852S\SQLEXPRESS;Database=AL_ESTILO_PIURA;Integrated Security=True;Application Name=AlEstiloPiurano;Connect Timeout=15;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <!-- Borrado definitivo de empleados, productos e insumos SIN historial.
             Apagado hasta que el Administrador apruebe las condiciones (ver EliminacionSegura.cs). -->
        <add key="PermitirEliminacionDefinitiva" value="false" />
    </appSettings>
</configuration>
